# Phoenix Shopper Assistant Configuration

# Port & Hosts
PORT=8000
API_BASE_URL=http://localhost:8000
SQLITE_DB_PATH=shop.db

# LLM Configuration
# Set MOCK_LLM=true to run without external LLM keys
MOCK_LLM=true

# Ollama local runtime (if MOCK_LLM=false and running Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Hosted LLM API (if using OpenAI / Gemini / etc.)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Vector Search (set to true if ChromaDB is installed)
USE_CHROMADB=false
